# ============================================================
# CREATERHUB CONFIGURATION TEMPLATE
# ============================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Relational Database Engine
# Leave blank to use high-performance built-in SQLite WAL (server/data/creatorhub.db)
# Or configure a PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/creatorhub
DATABASE_URL=

# JSON Web Token Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Client API Base URL
VITE_API_URL=http://localhost:5000

# Meta / Instagram Graph API v19.0 Configuration
# Real Data Only: Requires a Meta Developer App with Instagram Graph API permissions:
# - instagram_basic
# - instagram_manage_insights
# - pages_show_list
# - pages_read_engagement
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:5173/creator/dashboard

# Google Gemini GenAI API Key (Structured Creator Analytics)
# Grounded solely on real verified Instagram metrics
GEMINI_API_KEY=your_gemini_api_key

# Payment / Escrow Gateway Provider (Razorpay)
# When set to test keys (rzp_test_...), operates in Razorpay Test Mode with full API & Webhook validation.
# When left empty, falls back to Development Escrow Simulator.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
PAYMENT_PROVIDER_KEY=test_escrow_sim_key

